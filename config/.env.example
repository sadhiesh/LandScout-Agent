# Copy to .env at the repo root. Placeholders only — never commit a real .env.

# --- LLM gateway ---
# The gateway key is short-lived and fetched at process start by the configured
# helper command. Do NOT paste a key here; set the base URL, model, and helper only.
LLM_BASE_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl
LLM_MODEL=claude-sonnet-5
LLM_PROVIDER=eng_ai
LLM_KEY_HELPER=/Applications/devbar.app/Contents/MacOS/devbar auth claude

# --- OpenRouter (alternative provider for reasoning models) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Datastores ---
POSTGRES_DSN=postgresql://landscout:landscout@localhost:5432/landscout
REDIS_URL=redis://localhost:6379/0

# --- Service ports (defaults match docs/architecture.md) ---
API_PORT=8000
SUPERVISOR_PORT=8001
SCOUT_PORT=8002
ENRICHER_PORT=8003
SCORER_PORT=8004
MCP_PORT=8010

# --- Timeout configuration (seconds) ---
# Agent-to-agent communication timeouts
A2A_SUPERVISOR_TIMEOUT=900  # 15 minutes for full pipeline
A2A_SCOUT_TIMEOUT=600       # 10 minutes for large searches
A2A_ENRICHER_TIMEOUT=600    # 10 minutes for enrichment pipeline
A2A_SCORER_TIMEOUT=600      # 10 minutes for scoring and rationale generation

# LLM and HTTP timeouts
LLM_CALL_TIMEOUT=120        # 2 minutes for LLM calls
HTTP_CLIENT_TIMEOUT=30.0    # 30 seconds for HTTP requests
SSE_HEARTBEAT_INTERVAL=15.0 # 15 seconds between SSE heartbeats

# --- Optional data sources (all currently disabled) ---
ZONING_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
AUDIT_LOG_DIR=logs/audit

# --- Development flags ---
# Globally disable criteria caching (also controllable per-request via skip_cache flag)
DISABLE_CRITERIA_CACHE=false
